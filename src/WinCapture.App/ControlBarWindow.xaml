<ui:FluentWindow x:Class="WinCapture.App.ControlBarWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="WinCapture"
                 Icon="pack://application:,,,/Assets/AppIcon.ico"
                 SizeToContent="WidthAndHeight"
                 ResizeMode="CanMinimize"
                 ShowInTaskbar="True"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="WinCapture"
                     Background="{DynamicResource TitleBarBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="14,10,14,14">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SelectRegionButton" Content="영역 지정" Style="{StaticResource AppButtonStyle}"
                        Margin="0,0,8,0" Click="OnSelectRegionClick" />
                <Button x:Name="CaptureButton" Content="캡처" Style="{StaticResource AppButtonStyle}"
                        Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" Click="OnCaptureClick" />
                <Button x:Name="SettingsButton" Content="설정" Style="{StaticResource AppButtonStyle}"
                        Margin="0,0,8,0" Click="OnSettingsClick" />
                <Button x:Name="ToggleWindowsButton" Content="창 표시/숨김" Style="{StaticResource AppButtonStyle}"
                        Click="OnToggleWindowsClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton x:Name="ScreenshotModeButton" Content="사진" GroupName="CaptureMode"
                             Style="{StaticResource ModeChipStyle}" Margin="0,0,6,0" Checked="OnModeChecked" />
                <RadioButton x:Name="VideoModeButton" Content="동영상" GroupName="CaptureMode"
                             Style="{StaticResource ModeChipStyle}" Margin="0,0,6,0" Checked="OnModeChecked" />
                <RadioButton x:Name="GifModeButton" Content="GIF" GroupName="CaptureMode"
                             Style="{StaticResource ModeChipStyle}" Checked="OnModeChecked" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
