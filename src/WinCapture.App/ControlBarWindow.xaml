<ui:FluentWindow x:Class="WinCapture.App.ControlBarWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:WinCapture.App.Controls"
                 Title="WinCapture"
                 Icon="pack://application:,,,/Assets/AppIcon.ico"
                 SizeToContent="WidthAndHeight"
                 ResizeMode="CanMinimize"
                 ShowInTaskbar="True"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <!-- The ONLY place the outer margin is defined: 8 DIP on every side of the visible window.
             WindowInset = body margin (all four sides); WindowInsetX = the same 8 DIP, left/right only, for the
             full-width menu bar strip so its items sit in the same column as the body. -->
        <Thickness x:Key="WindowInset">8</Thickness>
        <Thickness x:Key="WindowInsetX">8,0,8,0</Thickness>
    </ui:FluentWindow.Resources>
    <!-- Size: SizeToContent=WidthAndHeight follows this root Grid. No Width/MinWidth on the window or the root.
         The visible width = body column + 2 x 8 DIP. The body column is as wide as the [Capture] button
         (no MinWidth: hidden sizer holding the longest label + icon + button Padding 18,12); the column is
         max(that button, the 3 mode buttons, the [Select region][Clear region] line) and every row stretches to it.
         The status card is wrapped in WidthIgnoringDecorator so changing coordinates never change the width.
         Resize/maximize lock: ResizeMode=CanMinimize (keeps the minimize button), TitleBar CanMaximize=False and the
         FixedSizeWindow helper (code-behind), see FixedSizeWindow.cs. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: title bar (icon, title, minimize, close; no maximize) -->
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="WinCapture"
                     Background="{DynamicResource TitleBarBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ShowMaximize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Row 1: menu bar [Settings] [Hotkeys] [Hide window] -->
        <Border Grid.Row="1" Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource WindowInsetX}">
            <StackPanel x:Name="MenuBar" Orientation="Horizontal">
                <Button x:Name="MenuSettingsButton" Content="설정" Style="{StaticResource MenuBarItemStyle}" Click="OnSettingsClick" />
                <Button x:Name="MenuHotkeysButton" Content="단축키" Style="{StaticResource MenuBarItemStyle}" Click="OnHotkeysClick" />
                <Button x:Name="MenuToggleWindowsButton" Content="창 숨기기" Style="{StaticResource MenuBarItemStyle}" Click="OnToggleWindowsClick" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="{StaticResource WindowInset}">
            <!-- Status card: region state + coordinates, border chip on the right -->
            <controls:WidthIgnoringDecorator>
            <Border x:Name="StatusCard" Style="{StaticResource CardStyle}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0"
                             VerticalAlignment="Center" Fill="{DynamicResource KeycapBorderBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitleText" FontFamily="{StaticResource AppFontFamily}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusCoordinatesText" FontFamily="Consolas" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="8,3" Margin="8,0,0,0"
                            Background="{DynamicResource HoverBrush}">
                        <TextBlock x:Name="BorderChipText" FontFamily="{StaticResource AppFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Border>
            </controls:WidthIgnoringDecorator>

            <!-- Mode selector: segmented control, single selection -->
            <Border Margin="0,12,0,0" CornerRadius="12" Padding="3" Background="{DynamicResource BorderBrush}">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="ScreenshotModeButton" Content="사진" GroupName="CaptureMode"
                                 Style="{StaticResource SegmentRadioStyle}" Checked="OnModeChecked" />
                    <RadioButton x:Name="VideoModeButton" Content="동영상" GroupName="CaptureMode"
                                 Style="{StaticResource SegmentRadioStyle}" Checked="OnModeChecked" />
                    <RadioButton x:Name="GifModeButton" Content="GIF" GroupName="CaptureMode"
                                 Style="{StaticResource SegmentRadioStyle}" Checked="OnModeChecked" />
                </UniformGrid>
            </Border>

            <!-- [Select region] [Clear region] on one line -->
            <UniformGrid Columns="2" Margin="0,12,0,0">
                <Button x:Name="SelectRegionButton" Content="영역 지정" Style="{StaticResource AppButtonStyle}"
                        Margin="0,0,4,0" Padding="14,9" FontWeight="SemiBold" Click="OnSelectRegionClick" />
                <Button x:Name="ClearRegionButton" Content="영역 해제" Style="{StaticResource AppButtonStyle}"
                        Margin="4,0,0,0" Padding="14,9" FontWeight="SemiBold" Click="OnClearRegionClick" />
            </UniformGrid>

            <!-- Big accent [Capture] button -->
            <Button x:Name="CaptureButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0"
                    Padding="18,12" ToolTipService.ShowOnDisabled="True" Click="OnCaptureClick">
                <Grid>
                    <!-- Hidden sizer: holds every capture label (filled in code from ControlBarText) so the button
                         is always as wide as the longest label and does not change width when the mode changes.
                         Left margin 26 = icon 18 + gap 8. -->
                    <Grid x:Name="CaptureLabelSizer" Visibility="Hidden" Margin="26,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:PathIcon Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Data="{StaticResource Icon.Capture}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock x:Name="CaptureButtonText" VerticalAlignment="Center" />
                </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
