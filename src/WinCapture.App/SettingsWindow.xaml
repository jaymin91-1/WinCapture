<ui:FluentWindow x:Class="WinCapture.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:WinCapture.App.Pages"
                 Title="WinCapture 설정" Height="520" Width="860"
                 MinHeight="400" MinWidth="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="WinCapture 설정"
                     Background="{DynamicResource TitleBarBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           PaneDisplayMode="Left"
                           OpenPaneLength="180"
                           Background="{DynamicResource WindowBackgroundBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}">
            <ui:NavigationView.Resources>
                <!-- Sidebar uses its own (white / darker) background. -->
                <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource AppNavigationItemStyle}" />
            </ui:NavigationView.Resources>
            <!-- Tab order follows SPEC section 4. -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="일반" TargetPageType="{x:Type pages:GeneralPage}">
                    <ui:NavigationViewItem.Icon>
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource NavIconPathStyle}" Data="{StaticResource Icon.General}" /></Viewbox>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="단축키" TargetPageType="{x:Type pages:HotkeysPage}">
                    <ui:NavigationViewItem.Icon>
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource NavIconPathStyle}" Data="{StaticResource Icon.Hotkeys}" /></Viewbox>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="캡처" TargetPageType="{x:Type pages:CapturePage}">
                    <ui:NavigationViewItem.Icon>
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource NavIconPathStyle}" Data="{StaticResource Icon.Capture}" /></Viewbox>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="녹화" TargetPageType="{x:Type pages:RecordingPage}">
                    <ui:NavigationViewItem.Icon>
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource NavIconPathStyle}" Data="{StaticResource Icon.Recording}" /></Viewbox>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="FFmpeg" TargetPageType="{x:Type pages:FfmpegPage}">
                    <ui:NavigationViewItem.Icon>
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource NavIconPathStyle}" Data="{StaticResource Icon.Ffmpeg}" /></Viewbox>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="정보" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <Viewbox Width="18" Height="18"><Path Style="{StaticResource NavIconPathStyle}" Data="{StaticResource Icon.About}" /></Viewbox>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
