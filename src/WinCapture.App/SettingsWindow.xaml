<ui:FluentWindow x:Class="WinCapture.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:WinCapture.App.Pages"
                 xmlns:controls="clr-namespace:WinCapture.App.Controls"
                 Title="WinCapture 설정" Height="520" Width="860"
                 Icon="pack://application:,,,/Assets/AppIcon.ico"
                 MinHeight="400" MinWidth="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="WinCapture 설정"
                     Background="{DynamicResource TitleBarBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           PaneDisplayMode="Left"
                           OpenPaneLength="180"
                           Background="{DynamicResource WindowBackgroundBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}">
            <ui:NavigationView.Resources>
                <!-- Sidebar uses its own (white / darker) background. -->
                <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource AppNavigationItemStyle}" />
            </ui:NavigationView.Resources>
            <!-- Tab order follows SPEC section 4. -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="일반" TargetPageType="{x:Type pages:GeneralPage}">
                    <ui:NavigationViewItem.Icon>
                        <controls:PathIcon Width="18" Height="18" Data="{StaticResource Icon.General}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="단축키" TargetPageType="{x:Type pages:HotkeysPage}">
                    <ui:NavigationViewItem.Icon>
                        <controls:PathIcon Width="18" Height="18" Data="{StaticResource Icon.Hotkeys}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="캡처" TargetPageType="{x:Type pages:CapturePage}">
                    <ui:NavigationViewItem.Icon>
                        <controls:PathIcon Width="18" Height="18" Data="{StaticResource Icon.Capture}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="녹화" TargetPageType="{x:Type pages:RecordingPage}">
                    <ui:NavigationViewItem.Icon>
                        <controls:PathIcon Width="18" Height="18" Data="{StaticResource Icon.Recording}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="FFmpeg" TargetPageType="{x:Type pages:FfmpegPage}">
                    <ui:NavigationViewItem.Icon>
                        <controls:PathIcon Width="18" Height="18" Data="{StaticResource Icon.Ffmpeg}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="정보" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <controls:PathIcon Width="18" Height="18" Data="{StaticResource Icon.About}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
