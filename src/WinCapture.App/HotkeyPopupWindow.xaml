<ui:FluentWindow x:Class="WinCapture.App.HotkeyPopupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="단축키"
                 Icon="pack://application:,,,/Assets/AppIcon.ico"
                 Width="400" SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True">
    <!-- Read-only list: no editing controls. Rows come from Core HotkeyRows. Width 400 DIP, height follows content,
         outer margin 12 DIP. Resize/maximize lock: ResizeMode=NoResize + FixedSizeWindow (code-behind). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="단축키"
                     Background="{DynamicResource TitleBarBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="12">
            <TextBlock Text="단축키" FontFamily="{StaticResource AppFontFamily}" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="현재 설정된 전역 단축키입니다." Margin="0,2,0,12" FontFamily="{StaticResource AppFontFamily}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />

            <Border Style="{StaticResource CardStyle}">
                <ItemsControl x:Name="RowsList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFontFamily}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="사용 중인 조합" VerticalAlignment="Center" Margin="0,0,10,0"
                                               FontFamily="{StaticResource AppFontFamily}" FontSize="11"
                                               Foreground="{DynamicResource WarningBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Keys}" VerticalAlignment="Center" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="3,0,0,0" MinWidth="34">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource KeycapStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsFailed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource KeycapTextStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="변경은 설정 › 단축키 탭에서 합니다." VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0" FontFamily="{StaticResource AppFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenSettingsButton" Content="설정 열기" Style="{StaticResource AppButtonStyle}"
                            Padding="14,7" FontWeight="SemiBold" Click="OnOpenSettingsClick" />
                    <Button x:Name="CloseButton" Content="닫기" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0" Padding="18,7" MinWidth="64" FontSize="13" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
