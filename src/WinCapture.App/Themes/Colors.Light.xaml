<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Values come from SPEC section 3. The accent is the app's own blue, not the system accent. -->
    <Color x:Key="WindowBackgroundColor">#F2F4F6</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E5E8EB</Color>
    <Color x:Key="TextPrimaryColor">#191F28</Color>
    <Color x:Key="TextSecondaryColor">#6B7684</Color>
    <Color x:Key="AccentColor">#2F7CF6</Color>
    <Color x:Key="SelectedTabBackgroundColor">#E8F3FF</Color>
    <Color x:Key="SelectedTabForegroundColor">#1B64DA</Color>
    <Color x:Key="WarningColor">#E5484D</Color>
    <Color x:Key="HoverColor">#F2F4F6</Color>
    <Color x:Key="MenuBackgroundColor">#FFFFFF</Color>
    <Color x:Key="KeycapBackgroundColor">#F2F4F6</Color>
    <Color x:Key="KeycapBorderColor">#D1D6DB</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SelectedTabBackgroundBrush" Color="{StaticResource SelectedTabBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedTabForegroundBrush" Color="{StaticResource SelectedTabForegroundColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource MenuBackgroundColor}" />
    <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="{StaticResource KeycapBackgroundColor}" />
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="{StaticResource KeycapBorderColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7684" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
</ResourceDictionary>
